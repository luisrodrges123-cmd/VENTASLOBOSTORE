          ".read": "auth != null && root.child('stores').child($storeId).child('profile').child('active').val() === true && root.child('memberships').child(auth.uid).child($storeId).child('active').val() === true && (root.child('memberships').child(auth.uid).child($storeId).child('role').val() === 'owner' || root.child('memberships').child(auth.uid).child($storeId).child('role').val() === 'manager' || root.child('memberships').child(auth.uid).child($storeId).child('role').val() === 'staff')",
